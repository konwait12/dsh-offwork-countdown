{
  "name": "dsh-offwork-countdown",
  "version": "1.1.0",
  "description": "A draggable off-work countdown card for the DeepSeek Harness Web GUI: remaining time, day progress, and inline work-hour settings.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "countdown",
    "off-work",
    "widget",
    "card",
    "browser-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konwait12/dsh-offwork-countdown.git"
  },
  "homepage": "https://github.com/konwait12/dsh-offwork-countdown#readme",
  "bugs": {
    "url": "https://github.com/konwait12/dsh-offwork-countdown/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
